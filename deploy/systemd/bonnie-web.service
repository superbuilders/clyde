# bonnie-web.service — the one privileged-ish web front end (PLAN.md §1, A8).
#
# M3 scope: users are real Unix users. Each authenticated email maps, through
# /etc/bonnie/users.map, to an account that owns its own home and runs its own
# agents on its own tmux socket. Isolation is a permission bit — Bob's agent
# reading Alice's tree gets EACCES from the kernel — not a policy check.
#
# That requires setuid, so this process runs as root with exactly four
# capabilities: CAP_SETUID and CAP_SETGID to become the owning user, CAP_CHOWN
# to hand newly created files to them, and CAP_DAC_READ_SEARCH because the
# viewer must read and traverse every user's 0750 home to render transcripts.
#
# CAP_DAC_OVERRIDE is deliberately absent, and the distinction is the whole
# design: the service may READ anything and WRITE nothing. Every write into a
# user's tree happens in a child that has setuid to that user, so the file
# lands owned by them and the agent can write it afterwards. A root-owned file
# in a user's home is a bug, and without DAC_OVERRIDE it is an impossible one.
#
# Because the service can read everything, it must decide what to *show*: see
# ownsPath() in the viewer. Both halves must hold; neither is sufficient alone.
#
# Two deviations from PLAN.md §1, both deliberate:
#
#  1. §1 says "bind 127.0.0.1:8080". An ALB reaches the instance over its
#     private IP, so a loopback-only bind is unreachable and the target would
#     never pass its health check. We bind 0.0.0.0:8080 and confine reachability
#     with the instance security group, which permits ingress on 8080 from the
#     ALB's security group only. The intent of §1 — never terminate TLS here,
#     never be directly reachable from the internet — is preserved. `:443`/`:80`
#     are never bound.
#  2. No socket activation. PLAN.md §4 explicitly deleted it. Restart safety
#     comes from agents living in tmux, not in this process's tree (§8.6), so a
#     restart costs a few refused connections, not a session.
#
# Never exec through a shell: ExecStart is explicit argv.

[Unit]
Description=Bonnie session viewer (authenticated)
Documentation=https://github.com/superbuilders/clyde
After=network-online.target srv-bonnie.mount
Wants=network-online.target
RequiresMountsFor=/srv/bonnie

[Service]
# Type=exec, not notify: the viewer never calls sd_notify. Under Type=notify
# systemd waits out TimeoutStartSec and then kills a healthy server.
Type=exec
# root, because spawning an agent as the owning user is setuid(2). The process
# immediately drops to the principal's uid in every child it forks; it never
# runs user code as root.
User=root
Group=root
WorkingDirectory=/srv/bonnie/home

# Explicit argv, no shell. The listen address is the only thing on the command
# line; every secret arrives through the environment file.
ExecStart=/opt/bonnie/current/bonnie --listen 0.0.0.0:8080 --multi-user --user-map /etc/bonnie/users.map
Restart=always
RestartSec=2

# Secrets and config arrive via the environment file (0640 root:bonnie), never
# on a command line — /proc/*/cmdline is world-readable.
EnvironmentFile=/etc/bonnie/web.env

# The agent needs a real HOME and a PATH that contains tmux, git and clyde.
Environment=HOME=/srv/bonnie/home
Environment=PATH=/opt/bonnie/current:/usr/local/bin:/usr/bin:/bin
Environment=SHELL=/bin/bash

# ── hardening (PLAN.md §1) ────────────────────────────────────────────────
# Exactly the capabilities multi-user spawning and transcript rendering need.
# The bounding set is the ceiling: even a compromised process cannot regain
# the rest.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_READ_SEARCH
# AmbientCapabilities is deliberately EMPTY, and this is load-bearing. Ambient
# capabilities are inherited across exec and survive a setuid to an
# unprivileged user — listing CAP_DAC_READ_SEARCH here would hand every spawned
# agent the ability to read every other user's home, which is precisely the
# thing M3 exists to prevent. The service needs no ambient set: it runs as uid
# 0, so its permitted set is the bounding set already.
AmbientCapabilities=
# NoNewPrivileges is OFF here, and this needs justifying.
#
# On systemd 255, NoNewPrivileges=yes combined with any directive that installs
# a seccomp filter (PrivateDevices, ProtectKernelTunables, ProtectClock,
# RestrictNamespaces, LockPersonality, SystemCallFilter, …) silently removes
# CAP_SETUID — and only CAP_SETUID — from the service's PERMITTED set, while
# leaving it in the bounding set that `systemctl show` reports. Every agent
# spawn then fails with a bare EPERM from fork/exec. Reproduced minimally:
#
#   systemd-run -p User=root -p CapabilityBoundingSet=CAP_SETUID #     -p NoNewPrivileges=true -p LockPersonality=true #     /bin/sh -c 'grep CapPrm /proc/self/status'
#
# Either directive alone leaves CapPrm intact; the pair does not. So the choice
# is NNP or the seccomp sandbox, and the sandbox is worth more: it is inherited
# by every agent, and this process legitimately must change uid, which is
# exactly what NNP exists to forbid.
#
# NNP is not lost, it is moved. Agents are spawned through
# `setpriv --no-new-privs` (see Principal.command), so the bit is set on the
# process that actually runs untrusted model output, and on everything it
# spawns — which is where it matters.
NoNewPrivileges=false

ProtectSystem=strict
# ProtectHome=read-only per §1; /srv/bonnie is not under /home, and it is listed
# read-write below because session transcripts are written there.
ProtectHome=read-only
ReadWritePaths=/srv/bonnie
# /run is tmpfs and is emptied on every boot. cloud-init created /run/bonnie
# once, but bonnie-setup is guarded by .setup-complete on the persistent data
# volume, so it never ran again — which meant that after any reboot the unit
# failed with 226/NAMESPACE on a missing ReadWritePaths target and the box came
# back permanently broken. RuntimeDirectory makes systemd create (and clean up)
# /run/bonnie on every start, so there is nothing left to go stale.
RuntimeDirectory=bonnie
# The viewer's session cache lives in /var/lib/bonnie. ProtectSystem=strict
# makes /var/lib read-only, so without this the service cannot create it and
# every restart rescans every session from scratch. StateDirectory both
# creates the directory and adds it to the read-write set, so it cannot drift
# out of sync with ReadWritePaths the way a hand-rolled entry would.
#
# 0700: this is service state spanning every user's sessions. No user should
# be able to read it, and none should be able to forge it.
StateDirectory=bonnie
StateDirectoryMode=0700
# ...but NOT torn down on stop, which is what the default would do.
#
# Every user's tmux socket lives in /run/bonnie/<user> (TMUX_TMPDIR), and
# agents deliberately run outside this process's tree so that a restart costs
# a few refused connections rather than a session. With the default
# RuntimeDirectoryPreserve=no that guarantee was false: systemd deleted
# /run/bonnie on stop, unlinking every live socket. The tmux servers kept
# running — with an agent inside, still spending tokens — permanently
# unreachable, because nothing reaps a server whose socket is gone.
#
# Every deploy restarts this unit, so that fired on each rollout, and it is
# fatal to self-shipping: restarting from inside a Bonnie session would orphan
# the very agent that issued the deploy.
#
# =yes only suppresses removal on stop. /run is tmpfs, so the directory is
# still gone after a reboot, which is the staleness RuntimeDirectory was added
# to fix in the first place.
RuntimeDirectoryPreserve=yes
# 0751, not 0750. Each user's tmux socket lives in /run/bonnie/<user>, and the
# agent — running as that user, not in the bonnie group — must traverse the
# parent to reach it. At 0750 tmux cannot see its own socket directory and
# silently falls back to /tmp, where every user shares one server: any user
# could then attach to another's agent. --x for others buys traversal without
# letting anyone enumerate who has a session.
RuntimeDirectoryMode=0751

PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_UNIX for tmux, AF_INET/AF_INET6 for HTTP and the OIDC/Anthropic calls.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

# MemoryDenyWriteExecute is deliberately NOT set: this process forks agents that
# exec a Go binary, and the Go runtime in a child can trip it.

ReadOnlyPaths=/opt/bonnie

[Install]
WantedBy=multi-user.target
