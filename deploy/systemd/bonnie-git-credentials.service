# bonnie-git-credentials.service — install a GitHub credential in every
# provisioned user's home (PLAN.md §M6).
#
# Oneshot, driven by bonnie-git-credentials.timer. It mints a GitHub App
# installation token and writes it into each user's ~/.git-credentials as that
# user.
#
# Why this exists at all: cloud-init installs a token into the *service*
# account's home, which was right when every agent ran as `bonnie` and became
# wrong when M3 moved agents to per-user accounts. M4.1 then closed those homes
# to `other`, so the file is not merely misplaced — it is unreadable by design.
# Until this ran, no user's agent could clone, fetch or push anything private.
#
# Why a timer rather than a credential helper that mints on demand: a helper
# would have to reach a privileged local service to use the App private key,
# and that service is unix-socket RPC with SO_PEERCRED, which PLAN.md §4
# deleted by name. A short-lived token in a 0600 file inside a 0750 home is the
# mechanism the box already uses, made per-user and rotating.
#
# Runs as root because it writes into other users' homes *as them* — the same
# rule as provision and share. It never writes as root.

[Unit]
Description=Install GitHub App credentials for Bonnie users
Documentation=https://github.com/superbuilders/clyde
After=network-online.target srv-bonnie.mount
Wants=network-online.target
RequiresMountsFor=/srv/bonnie

[Service]
Type=oneshot
User=root
Group=root

# Explicit argv, no shell. The secret id is configuration, not a secret: it
# names where the credential lives, and reading it needs the instance role.
ExecStart=/opt/bonnie/current/bonnie git-credentials --secret ${BONNIE_GITHUB_SECRET} --region ${AWS_REGION}
EnvironmentFile=/etc/bonnie/web.env
Environment=PATH=/opt/bonnie/current:/usr/local/bin:/usr/bin:/bin

# Far less hardening than bonnie-web, and deliberately so: this has to become
# five different users and write into their homes, so most of the sandbox that
# makes sense for a web server is exactly what would break it. It runs for a
# second, on a timer, executing no user input.
ProtectSystem=strict
ReadWritePaths=/srv/bonnie
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
