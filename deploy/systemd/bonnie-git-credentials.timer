# bonnie-git-credentials.timer — keep the GitHub token fresh (PLAN.md §M6).
#
# GitHub App installation tokens expire one hour after they are minted. The
# interval here is 45 minutes, not 60: a token that expires exactly when the
# next one is written leaves a window in which git fails, and the failure
# looks like a permissions problem rather than a clock problem. Fifteen
# minutes of overlap costs one extra API call an hour and removes the class of
# bug entirely.
#
# OnBootSec is short because a box that has just come up has no valid token at
# all — cloud-init writes one for the service account only. Until this fires,
# every user's agent is in exactly the broken state M6 exists to fix.
#
# Persistent=false on purpose. This is not work that must be caught up after
# downtime: a missed run is meaningless, because any token it would have
# written has since expired anyway. The next run mints a fresh one.

[Unit]
Description=Refresh GitHub App credentials for Bonnie users
Documentation=https://github.com/superbuilders/clyde

[Timer]
OnBootSec=30s
OnUnitActiveSec=45min
AccuracySec=1min
Persistent=false

[Install]
WantedBy=timers.target
