# Anthropic API Key (or compatible gateway key)
# Get your API key from: https://console.anthropic.com/settings/keys
TS_AGENT_API_KEY=your-anthropic-api-key-here

# Optional: Point at an Anthropic-compatible API proxy
# (e.g. Cloudflare AI Gateway, LiteLLM, or any /messages-compatible proxy)
# If not set, defaults to Anthropic direct.
# TS_AGENT_API_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/anthropic/v1/messages
# TS_AGENT_MODEL_ID=claude-opus-4-6

# ── Model behavior ───────────────────────────────────────────────────────────
# Clyde pins every behavior-affecting API parameter explicitly so that changing
# TS_AGENT_MODEL_ID cannot silently change how the harness behaves. The pinned
# baseline is Claude Opus 4.6. See agent/providers/types.go for the full list
# and the rationale for each value.

# Reasoning depth: low | medium | high | xhigh | max
# Default is "low", calibrated to match Opus 4.6's default thinking volume.
# Raising this increases thinking tokens (cost + latency) substantially:
# on Opus 5, medium is ~3.4x the thinking of the 4.6 baseline.
# TS_AGENT_THINKING_EFFORT=low

# Max output tokens per call. On Opus 5 this caps thinking + visible text
# COMBINED, so an undersized value lets reasoning starve the answer.
# TS_AGENT_MAX_TOKENS=64000

# Model context window, used to size the compaction threshold.
# TS_AGENT_CONTEXT_WINDOW=200000

# DEPRECATED: rejected with a 400 by Opus 5 and newer. If set, it is
# translated to the nearest TS_AGENT_THINKING_EFFORT level and warns.
# THINKING_BUDGET_TOKENS=8192
